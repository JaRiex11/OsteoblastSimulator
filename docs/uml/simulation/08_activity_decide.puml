@startuml simulation_activity_decide
skinparam shadowing false
title Диаграмма деятельности — выбор действия клетки (_pick_action_type)

start
:вход: p_migrate, p_prolif;
:нормализация в [0,1];
if (p_m + p_p == 0?) then (да)
  stop
endif

if (p_m + p_p > 1?) then (да)
  :p_m /= (p_m + p_p)\np_p /= (p_m + p_p);
endif

:r = random();

if (r < p_m?) then (да)
  :**MIGRATE**;
  stop
elseif (r < p_m + p_p?) then (да)
  :**PROLIF**;
  stop
else (нет)
  :**покой** (None);
  stop
endif

@enduml
